{
  "name": "lidar-arch-web",
  "version": "0.2.0",
  "private": true,
  "description": "lidar-arch web — 3DEP coverage picker + run-on-the-map (Worker + container).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "container:wheel": "pwsh container/build-wheel.ps1",
    "container:build": "docker build -t lidar-arch:dev container",
    "container:run": "docker run --rm -p 8080:8080 lidar-arch:dev"
  },
  "devDependencies": {
    "wrangler": "^4.98.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  }
}
